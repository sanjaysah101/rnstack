# API base URL. Public (EXPO_PUBLIC_*) so it's inlined into the client bundle.
# The api-client appends routes under /v1 — do NOT include /v1 here.
EXPO_PUBLIC_API_BASE_URL=https://example.com

# Build variant: development | preview | production.
# Selects the app's name / bundle-id suffix / scheme (see apps/mobile/app.config.ts)
# so dev, preview, and production can be installed side by side. Normally set per
# EAS build profile in eas.json; override locally with e.g.
#   APP_VARIANT=preview npx expo start
# Defaults to "development" when unset.
# APP_VARIANT=development
